{
  "name": "vulnlens-backend",
  "version": "1.0.0",
  "description": "VulnLens AI - Backend API and Security Scanner",
  "main": "src/server.js",
  "bin": {
    "vulnlens": "./bin/vulnlens.js"
  },
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "cross-env NODE_ENV=test node --test tests/**/*.test.js",
    "test:corpus": "node tests/run-corpus.mjs",
    "test:corpus:strict": "node tests/run-corpus.mjs --strict",
    "vulnlens": "node bin/vulnlens.js"
  },
  "dependencies": {
    "acorn": "^8.18.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^2.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "js-yaml": "^5.4.1",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.9"
  },
  "allowScripts": {
    "mongodb-memory-server@11.2.0": true
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
