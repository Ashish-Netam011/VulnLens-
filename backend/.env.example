# Server
PORT=5000
NODE_ENV=development

# MongoDB (Atlas cloud connection string)
MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/vulnlens?retryWrites=true&w=majority

# JWT
# Generate a strong secret, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The server refuses to boot with an insecure/dev secret when NODE_ENV=production.
JWT_SECRET=change-this-to-a-strong-random-secret
JWT_EXPIRES_IN=7d

# AI Provider: "openrouter" | "ollama" | "none"
AI_PROVIDER=none

# OpenRouter (cloud AI)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# Ollama (local AI)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=codellama

# AI Reliability (timeout + retries)
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=1

# Rate Limiting (global API)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Rate Limiting (auth endpoints — stricter)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# File Upload
MAX_FILE_SIZE_BYTES=2097152

# CORS (production only — set to your frontend URL)
CORS_ORIGIN=

# Dependency / CVE intelligence (OSV.dev — no API key required)
OSV_API_URL=https://api.osv.dev/v1/querybatch
CVE_LOOKUP_TIMEOUT_MS=12000
CVE_LOOKUP_CACHE_TTL_MS=21600000
